+static void
+start(void) {
+        int i;
+        catsWaiting = miceWaiting = catsEating = miceEating = 0;
+        for (i = 0; i < NFOODBOWLS; i++) dishBeingUsed[i] = false;
+
+        mutex = sem_create("mutex", 1);
+        catSemaphore = sem_create("cats", 0);
+        mouseSemaphore = sem_create("mice", 0);
+        finished = sem_create("done", 0);
+
+
+        turnFlag = noTurn;
+}
+
+static void
+reset(void) {
+        // Destroy all semaphores
+        sem_destroy(mutex);
+        sem_destroy(catSemaphore);
+        sem_destroy(mouseSemaphore);
+        sem_destroy(finished);
+}
+
+static void
+catBegin(bool *firstCat, bool *currCat) {
+        P(mutex);
+        catsWaiting++;
+
+        if(turnFlag == noTurn && catsEating == 0 && miceEating == 0) {
+                turnFlag = catTurn;
+                V(catSemaphore);
+        }
+        V(mutex);
+
+        P(catSemaphore);
+
+        P(mutex);
+        *firstCat = (catsEating == 0);
+        *currCat = false;
+
+        if (*firstCat && catsWaiting > 1 && catsEating < NFOODBOWLS) {
+                *currCat = true;
+                V(catSemaphore);
+        } 
+        V(mutex);
+}
+
+static void catEat(unsigned long catNumber, int *dish) {
+        int i;
+        P(mutex);
+
+        for (i = 0; i < NFOODBOWLS; i++) {
+                if(dishBeingUsed[i] == false) {
+                        dishBeingUsed[i] = true;
+                        *dish = i + 1;
+                        break;
+                }
+        }
+        catsEating++;
+        V(mutex);
+        kprintf("cat %lu is eating out of dish %d\n", catNumber, *dish);
+}
+
+
+static void mouseBegin(bool *firstMouse, bool *currMouse) {
+        P(mutex);
+        miceWaiting++;
+
+        if(turnFlag == noTurn && miceEating == 0 && catsEating == 0) {
+                turnFlag = miceTurn;
+                V(mouseSemaphore);
+        }
+        V(mutex);
+
+        P(mouseSemaphore);
+
+        P(mutex);
+        *firstMouse = (miceEating == 0);
+        *currMouse = false;
+
+        if (*firstMouse && miceWaiting > 1 && miceEating < NFOODBOWLS) {
+                *currMouse = true;
+                V(mouseSemaphore);
+        } 
+        V(mutex);
+}
+
+static void mouseEat(unsigned long mouseNumber, int *dish) {
+        int i;
+        P(mutex);
+
+        for (i = 0; i < NFOODBOWLS; i++) {
+                if(dishBeingUsed[i] == false) {
+                        dishBeingUsed[i] = true;
+                        *dish = i + 1;
+                        break;
+                }
+        }
+        miceEating++;
+        V(mutex);
+        kprintf("mouse %lu is eating out of dish %d\n", mouseNumber, *dish);
+}
+
+static void mouseReleaseDish(int dish) {
+        P(mutex);
+        dishBeingUsed[dish-1] = false;
+        miceWaiting--;
+        miceEating--;
+        V(mutex);
+
+}
+static void catReleaseDish(int dish) {
+        P(mutex);
+        dishBeingUsed[dish-1] = false;
+        catsWaiting--;
+        catsEating--;
+        V(mutex);
+}
+
+static void catSwitch(void) {
+        P(mutex);
+        if (catsEating == 0) {
+                if (miceWaiting > 0) {
+                        turnFlag = miceTurn;
+                        V(mouseSemaphore);
+                }
+                else if (catsWaiting > 0) {
+                        turnFlag = catTurn;
+                        V(catSemaphore);
+                }
+                else {
+                        turnFlag = noTurn;
+                }
+        }
+        V(mutex);
+}
+
+static void mouseSwitch(void) {
+    P(mutex);
+    if (miceEating == 0) {
+        if (catsWaiting > 0) {
+            turnFlag = catTurn;
+            V(catSemaphore);
+        } else if (miceWaiting > 0) {
+            // keep mice going
+            turnFlag = miceTurn;
+            V(mouseSemaphore);
+        } else {
+            turnFlag = noTurn;
+        }
+    }
+    V(mutex);
+}
