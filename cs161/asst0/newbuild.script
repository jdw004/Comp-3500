[1;14r[11;1H[36m# Note: when running the config script, be sure to be in the[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m# right directory (the same one this file is in) and run it as[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m# "./config", not just "config" - in the latter case you will[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m# probably get the host system's kernel config utility, which[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m# will likely make a mess and produce mysterious error messages.[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m# The documentation for the syntax of these files follows.[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;11r8
[1;14r[11;1H[?25l[12d[K[?12l[?25h7[2;12r8
[1;14r[11;1H[36m############################################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Kernel config file syntax:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for specifying the processor architecture to use is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    arch archname[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       This must come before anything else in the kernel config.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for including the system definition is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    include conf.kern[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       This should come second, after the architecture. This is[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       because the system must be defined before you can do much[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       else useful.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       You can also include other files using the same syntax.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for turning on a kernel compile option is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    options optname[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       A previous "defoption" must have been seen first. See below[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       for more information.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The act of compiling with debug info is (has to be) handled[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       specially, and is just "debug" without the "options".[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for turning on a device driver is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    device foo%[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    device foo% at bar%[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       where the % is either a number or a star, which is treated as[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       a wildcard. The first line enables a device foo that is not[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       supposed to be "attached" to anything. The second line enables[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       a device foo that is attached to a device bar. For more [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       information about what this means, see below.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m############################################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Kernel definition file syntax:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Note: All source file names are relative to the top directory of the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# kernel source, that is, src/kern.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for adding a regular source file is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    file sourcefile.c[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Such a file is always included automatically in every kernel.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for defining optional source files is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    defoption optname[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    optfile optname sourcefile.c[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    optofffile optname sourcefile.c[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       "defoption" declares the name of a kernel option. These are[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       then turned on by including "options optname" in a[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       kernel config.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Source files added with optfile are compiled in if the option[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       specified is enabled. Source files added with optofffile are[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       compiled in if the option specified is not enabled.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Additionally, a file "opt-optname.h" is created in the compile[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       directory, which defines a C preprocessor symbol OPT_OPTNAME.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       This symbol is #defined to either 0 or 1 in the logical way.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Thus, you can have small bits of code that are enabled or[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       disabled by particular options by writing constructs like[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#            #include "opt-foo.h"[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#            #if OPT_FOO[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[15X[11;17Hcode();[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#            #else[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[15X[11;17Hother_code();[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#            #endif[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       *** Be sure to use #if and not #ifdef - you want the value[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           of the symbol.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       *** Be sure to remember to include the header file for the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           option - if you don't, cpp will silently assume it is 0,[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           which can be quite frustrating.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The defoption must be seen before any optional file [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       declarations that use it.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for defining device drivers is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    defdevice devname[18X[11;41Hsourcefile.c[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    defattach devname% otherdevname%   sourcefile.c[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    pseudoattach devname%[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Declare a device driver and its "attachment(s)". (The device[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       driver can then be selectively included or not included in any[39m(B[m[?25l[?12l[?25h7[2;12r8[12d[2S[1;14r[10;1H[36m#       particular kernel by using the "device" statement in the[11d#       kernel config file.)[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The specified source files are only compiled if the device[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       is enabled.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The % is either a specific number N, meaning "only the Nth[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       such device can be attached this way", or a star (*), meaning[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       "any such device can be attached this way".[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       In OS/161, device drivers are conceptually organized into[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       trees. This mimics the organization of real hardware, where[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       several expansion cards are plugged into one bus and there[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       might be several devices on each expansion card and so forth.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       There can be any number of these trees. However, devices at[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       the root of each tree must be able to probe and "find"[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       themselves completely on their own. This generally means that[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       they are either all software with no hardware, or they are the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       system main bus which is located in a machine-dependent way.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Software-only devices are known as "pseudo-devices". These[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       are "attached" with the pseudoattach directive; functions[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       of the form[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           pseudoattach_devname[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       are called from autoconf.c to create instances as requested.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       These calls are made from the function pseudoconfig(), which[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       should be called from dev/init.c after hardware device [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       initialization completes. The pseudoattach functions should[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       perform all setup and initialization necessary. (No[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       config_devname function will be called.)[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Devices with attachments are automatically probed and [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       configured from code in autoconf.c. This file is generated[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       by the config script. It contains functions called[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       "autoconf_devname", for each device. These functions call[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       other functions, which are supplied by device drivers,[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       which have the following hardwired names:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           attach_devname1_to_devname2[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19HA "devname2" device has been found and configured;[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Hthis function attempts to probe the devname2 for[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Ha "devname1" device. Returns NULL if nothing was[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Hfound.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#           config_devname[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19HA "devname" device has been found. This function[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Hcan then perform initialization that's shared[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Hamong all the possible things it can be attached[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[17X[11;19Hto.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The idea is that there can be multiple attachments for[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       the same device to different underlying devices. In the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       real world this can be used to great effect when you have,[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       for instance, the same ethernet chipset used on both PCI[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       and ISA cards - the chipset behaves the same way in both[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       cases, but the probe and attach logic is very different.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       The attach_foo_to_bar functions are put in the files[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       specified with defattach; the config_foo function (and[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       generally the rest of the driver for the foo device) is[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       put in the file specified with defdevice.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       One selects particular attachments when including the device[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       in the kernel. A top-level device with no attachments should[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       be included with this syntax:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice bar[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       A pseudo-device should be included with this syntax:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice bar0[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       To make use of device foo, which can be found attached to[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       device bar, one of the following syntaxes is used:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice foo* at bar*[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice foo* at bar0[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice foo0 at bar*[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[14X[11;16Hdevice foo0 at bar0[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       depending on to what extent you want to configure only a[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       specific device number.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       It sometimes matters what order things are handled in; probes[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       occur more or less in the order things appear in the config,[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       as constrained by the tree structure of the available devices.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Note that OS/161 does not make extensive use of this [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       functionality, and the device driver architecture outlined [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       here is overkill for such a limited environment as System/161.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       However, it's similar to the way real systems are organized.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# The syntax for including other config/definition files is:[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    include filename[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#    archinclude arch-filename[39m(B[m[?25l[?12l[?25h7[2;12r8[12d[2S[1;14r[10;1H[36m#[11d#       In the first form, the filename is relative to the top of[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       the kernel source tree.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       In the second form, the arch-filename is relative to the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       top directory of the architecture-specific area for the[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       selected architecture.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#       Thus, if the architecture is "mips", [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#          include conf/conf.foo     includes src/kern/conf/conf.foo[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#          archinclude conf/conf.bar includes src/kern/arch/mips/conf/conf.bar[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m############################################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m########################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[38X[11;40H#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Generic machine-independent devices. #[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[38X[11;40H#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m########################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# These are abstract system services we expect the system hardware to[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# provide: beeping, system console I/O, and time of day clock.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# These come before the archinclude so that the hardware device[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# definitions, which are included from there, can define attachments[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# for them.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefdevice[17Gbeep[38;5;208m[20X[11;41H[39m(B[mdev/generic/beep.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefdevice[38;5;208m       [39m(B[mcon[38;5;208m[21X[11;41H[39m(B[mdev/generic/console.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefdevice[17Grtclock[11;41Hdev/generic/rtclock.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefdevice[17Grandom[11;41Hdev/generic/random.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Random number generator for when there's no hardware random device.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Use "pseudoattach" because it's an all-software ("pseudo-") device.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# (It's also a pseudo-random generator, but the two uses of pseudo are[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# unrelated.)[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefdevice[38;5;208m       [39m(B[mpseudorand[38;5;208m[14X[11;41H[39m(B[mdev/generic/pseudorand.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hpseudoattach    pseudorand[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1Hdefattach[38;5;208m       [39m(B[mrandom0 pseudorand0[38;5;208m     [39m(B[mdev/generic/pseudorand_att.c[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m########################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[38X[11;40H#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#        Machine-dependent stuff       #[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[38X[11;40H#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m########################################[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# Get the definitions for whatever the architecture is from [39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# conf.arch in the architecture's conf directory.[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m#[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# This will declare a bunch of machine-dependent source files and also[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# declare all the hardware devices (since what sorts of hardware we[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
[1;14r[11;1H[36m# expect to find is machine-dependent.)[39m(B[m[?25l[?12l[?25h7[2;12r8[12d
